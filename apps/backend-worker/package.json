{
  "name": "@app/backend-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx --import ./src/otel/register.ts src/main.ts",
    "dev:watch": "tsx watch --import ./src/otel/register.ts src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/otel/register.js ./dist/main.js",
    "test": "node --experimental-test-module-mocks --import tsx --test src/**/*.test.ts",
    "test:containers": "BACKEND_TESTS_WITH_CONTAINERS=1 node --experimental-test-module-mocks --import tsx --test src/processors/ai/__tests__/ai-pipeline.integration.test.ts",
    "test:lex:integration": "node --experimental-test-module-mocks --import tsx --test src/routes/__tests__/dashboard.test.ts src/routes/__tests__/queues.test.ts src/services/__tests__/lex-ops.test.ts src/processors/lex/__tests__/integration/*.integration.test.ts",
    "test:lex:performance": "RUN_PERF_TESTS=1 node --experimental-test-module-mocks --import tsx --test src/processors/lex/__tests__/performance/*.performance.test.ts",
    "test:lex:chaos": "RUN_CHAOS_TESTS=1 node --experimental-test-module-mocks --import tsx --test src/processors/lex/__tests__/chaos/*.test.ts"
  },
  "dependencies": {
    "@app/ai-engine": "workspace:*",
    "@app/config": "workspace:*",
    "@app/database": "workspace:*",
    "@app/logger": "workspace:*",
    "@app/pim": "workspace:*",
    "@app/queue-manager": "workspace:*",
    "@app/scraper": "workspace:*",
    "@app/shopify-client": "workspace:*",
    "@app/types": "workspace:*",
    "@app/validation": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.2.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.69.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.212.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@opentelemetry/sdk-trace-node": "^2.5.1",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "bullmq": "^5.69.1",
    "cron-parser": "^5.5.0",
    "fast-json-stable-stringify": "^2.1.0",
    "fastify": "^5.7.4",
    "form-data": "^4.0.5",
    "ioredis": "^5.9.3",
    "stream-json": "^1.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.11.0",
    "@testcontainers/redis": "^11.11.0",
    "nock": "^14.0.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
