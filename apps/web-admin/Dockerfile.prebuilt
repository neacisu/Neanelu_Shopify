# syntax=docker/dockerfile:1.6
#
# Emergency/ops Dockerfile: build image from prebuilt dist artifacts.
# This avoids dependency downloads during outages of npm.taskforce.sh.
#
# Usage:
#   pnpm --filter @app/web-admin... run build
#   docker build -f apps/web-admin/Dockerfile.prebuilt -t <tag> .
#
FROM nginx:1.27-alpine

COPY apps/web-admin/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/web-admin/dist /usr/share/nginx/html

EXPOSE 65001

CMD ["nginx", "-g", "daemon off;"]

