# PgBouncer config template (static defaults)
# NOTE: In production/staging we render the real config via OpenBao Agent into:
#   /run/neanelu/runtime-secrets/infra/pgbouncer.ini
#
# This file exists as a human-readable baseline and for local dry-runs.

[databases]
* = host=10.0.1.107 port=5432

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 6432

auth_type = scram-sha-256
auth_dbname = postgres
auth_user = neanelu_pgbouncer_auth
auth_query = SELECT usename, passwd FROM public.neanelu_pgbouncer_get_auth($1);
auth_file = /etc/pgbouncer/userlist.txt

pool_mode = transaction
server_reset_query = DISCARD ALL
max_client_conn = 1000
default_pool_size = 50

