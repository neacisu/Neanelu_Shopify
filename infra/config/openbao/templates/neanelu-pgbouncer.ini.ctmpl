{{/*
=============================================================================
OpenBao Agent Template: Neanelu PgBouncer config (auth_query, dynamic users)
=============================================================================
Destination: /secrets/pgbouncer.ini
=============================================================================
*/}}
# Auto-generated by OpenBao Agent - DO NOT EDIT MANUALLY
# Generated: {{ timestamp }}

[databases]
# Allow all databases on CT107; clients choose database name in connection string.
* = host=10.0.1.107 port=5432

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 6432
unix_socket_dir =

# Client auth: fetch SCRAM verifiers from PostgreSQL for Neanelu-only roles.
auth_type = scram-sha-256
auth_dbname = postgres
{{- with secret "secret/neanelu/infra/pgbouncer" }}
auth_user = {{ .Data.auth_user }}
{{- end }}
auth_query = SELECT usename, passwd FROM public.neanelu_pgbouncer_get_auth($1);

# Where PgBouncer reads auth_user password (plaintext).
auth_file = /etc/pgbouncer/userlist.txt

pool_mode = transaction
max_client_conn = 1000
default_pool_size = 50
min_pool_size = 5
reserve_pool_size = 10
reserve_pool_timeout = 5
ignore_startup_parameters = extra_float_digits
server_reset_query = DISCARD ALL

# Log settings
log_connections = 1
log_disconnections = 1
verbose = 0

# Admin / stats users (inside PgBouncer)
admin_users = postgres
{{- with secret "secret/neanelu/infra/pgbouncer" }}
stats_users = {{ .Data.auth_user }}
{{- end }}

