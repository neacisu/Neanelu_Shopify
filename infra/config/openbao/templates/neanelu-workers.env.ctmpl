{{/*
=============================================================================
OpenBao Agent Template: Neanelu Workers Environment
=============================================================================
Destination: /secrets/neanelu-workers.env
=============================================================================
*/}}
# Auto-generated by OpenBao Agent - DO NOT EDIT MANUALLY
# Generated: {{ timestamp }}

{{- $env := env "NEANELU_ENV" -}}
{{- $db := "neanelu_shopify" -}}
{{- $role := "neanelu-prod-dynamic" -}}
{{- $redis_path := "secret/neanelu/prod/redis" -}}
{{- if eq $env "staging" -}}
  {{- $db = "neanelu_shopify_staging" -}}
  {{- $role = "neanelu-staging-dynamic" -}}
  {{- $redis_path = "secret/neanelu/staging/redis" -}}
{{- else if eq $env "dev" -}}
  {{- $db = "neanelu_shopify_dev" -}}
  {{- $role = "neanelu-dev-dynamic" -}}
  {{- $redis_path = "secret/neanelu/dev/redis" -}}
{{- end -}}

# =============================================================================
# App runtime basics
# =============================================================================
NODE_ENV={{ if eq $env "dev" }}development{{ else if eq $env "staging" }}staging{{ else }}production{{ end }}
LOG_LEVEL={{ if eq $env "dev" }}info{{ else if eq $env "staging" }}info{{ else }}warn{{ end }}
# IMPORTANT: runtime DB uses PgBouncer (no TLS on 6432). SSL=require will fail with:
# "The server does not support SSL connections".
DB_SSL_MODE=disable
OTEL_SERVICE_NAME=neanelu-shopify

# =============================================================================
# Database (via PgBouncer)
# =============================================================================
{{- with secret (printf "neanelu-db/creds/%s" $role) }}
DATABASE_URL=postgresql://{{ .Data.username }}:{{ .Data.password }}@pgbouncer:6432/{{ $db }}
POSTGRES_USER={{ .Data.username }}
POSTGRES_PASSWORD={{ .Data.password }}
MIGRATION_DATABASE_URL=postgresql://{{ .Data.username }}:{{ .Data.password }}@10.0.1.107:5432/{{ $db }}
{{- end }}

# =============================================================================
# Redis (shared, via hz.247 VIP)
# =============================================================================
{{- with secret $redis_path }}
REDIS_URL=redis://{{ .Data.redis_username }}:{{ .Data.redis_password }}@{{ .Data.redis_host }}:{{ .Data.redis_port }}/0
REDIS_PASSWORD={{ .Data.redis_password }}
REDIS_KEY_PATTERN={{ .Data.redis_key_pattern }}
REDIS_PREFIX={{ trimSuffix "*" .Data.redis_key_pattern }}
BULLMQ_PREFIX={{ trimSuffix "*" .Data.redis_key_pattern }}
{{- end }}

# =============================================================================
# Observability (central OTLP via Traefik)
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-neanelu.neanelu.ro

OPENBAO_SECRETS_LOADED=true
OPENBAO_SECRETS_TIMESTAMP={{ timestamp }}

