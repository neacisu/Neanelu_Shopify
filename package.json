{
  "name": "neanelu-shopify",
  "version": "0.1.0",
  "description": "Manager Shopify enterprise application",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -w exec tsc --noEmit",
    "test": "pnpm -r --if-present run test",
    "ci": "pnpm lint && pnpm typecheck && pnpm test",
    "smoke": "node --import tsx ./scripts/smoke-runner.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "db:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f",
    "db:restart": "pnpm db:down && pnpm db:up",
    "db:clean": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down -v",
    "db:watch": "docker compose -f docker-compose.yml -f docker-compose.dev.yml watch",
    "db:watch:build": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build --watch",
    "db:generate": "scripts/with-secrets.sh pnpm --filter @app/database run db:generate",
    "db:migrate": "scripts/with-secrets.sh pnpm --filter @app/database run db:migrate",
    "db:studio": "scripts/with-secrets.sh pnpm --filter @app/database run db:studio",
    "db:push": "scripts/with-secrets.sh pnpm --filter @app/database run db:push",
    "db:seed": "scripts/with-secrets.sh pnpm --filter @app/database run db:seed",
    "db:seed:ci": "scripts/with-secrets.sh pnpm --filter @app/database run db:seed:ci",
    "db:seed:taxonomy": "scripts/with-secrets.sh pnpm --filter @app/database run db:seed:taxonomy",
    "db:test": "scripts/with-secrets.sh pnpm --filter @app/database run test",
    "db:test:schema": "scripts/with-secrets.sh pnpm --filter @app/database run test:schema",
    "db:test:precommit": "scripts/with-secrets.sh pnpm --filter @app/database run test:precommit",
    "db:test:all": "scripts/with-secrets.sh pnpm --filter @app/database run test:all",
    "test:perf:bulk:1m": "RUN_PERF_TESTS=1 PERF_ROWS=1000000 PERF_SOAK_RUNS=10 node --experimental-test-module-mocks --import tsx --test apps/backend-worker/src/processors/bulk-operations/__tests__/performance/bulk-ingest.performance.test.ts",
    "test:perf:bulk:baseline": "RUN_PERF_TESTS=1 PERF_ROWS=1000000 PERF_SOAK_RUNS=10 PERF_WRITE_BASELINE=1 node --experimental-test-module-mocks --import tsx --test apps/backend-worker/src/processors/bulk-operations/__tests__/performance/bulk-ingest.performance.test.ts",
    "test:e2e:lex": "pnpm --config.engine-strict=false --filter @app/web-admin test:e2e",
    "test:integration:lex": "pnpm --config.engine-strict=false --filter @app/backend-worker test:lex:integration && pnpm --config.engine-strict=false --filter @app/web-admin exec vitest run -c vitest.config.ts app/routes/dashboard/components/SystemAlertsBanner.test.tsx app/routes/dashboard/components/LexOperationsPanel.test.tsx app/routes/__tests__/app.pim.translations.lex.test.tsx",
    "test:perf:lex:smoke": "RUN_PERF_TESTS=1 PERF_DASHBOARD_ITERATIONS=40 PERF_DASHBOARD_P95_MS=150 pnpm --config.engine-strict=false --filter @app/backend-worker test:lex:performance",
    "test:perf:lex:nightly": "RUN_PERF_TESTS=1 PERF_DASHBOARD_ITERATIONS=160 PERF_DASHBOARD_P95_MS=200 pnpm --config.engine-strict=false --filter @app/backend-worker test:lex:performance",
    "test:chaos:lex": "RUN_CHAOS_TESTS=1 pnpm --config.engine-strict=false --filter @app/backend-worker test:lex:chaos",
    "test:release:lex": "pnpm --config.engine-strict=false run test:integration:lex && pnpm --config.engine-strict=false run test:e2e:lex && pnpm --config.engine-strict=false run test:perf:lex:smoke && pnpm --config.engine-strict=false run test:chaos:lex",
    "dev:local": "scripts/with-secrets.sh docker compose -f docker-compose.staging.yml -f docker-compose.dev-local.yml --profile dev up -d backend-worker-dev web-admin-dev",
    "dev:local:build": "scripts/with-secrets.sh docker compose -f docker-compose.staging.yml -f docker-compose.dev-local.yml --profile dev build --no-cache backend-worker-dev web-admin-dev",
    "dev:local:logs": "docker compose -f docker-compose.staging.yml -f docker-compose.dev-local.yml --profile dev logs -f backend-worker-dev web-admin-dev",
    "test:queues-ws": "scripts/with-secrets.sh pnpm tsx scripts/test-queues-ws.ts",
    "oauth:server": "tsx oauth-callback-server.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "protobufjs"
    ],
    "ignoredBuiltDependencies": [
      "cpu-features",
      "ssh2"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pg": "^8.18.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "ws": "^8.19.0"
  },
  "dependencies": {
    "google-auth-library": "^10.5.0"
  }
}
